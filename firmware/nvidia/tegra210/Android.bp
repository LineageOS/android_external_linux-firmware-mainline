prebuilt_firmware {
    name: "linux_firmware_nvidia-tegra210",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    licenses: ["linux_firmware_nvidia_license"],
    srcs: [
        "vic04_ucode.bin",
        "xusb.bin",
    ],
    dsts: [
        "nvidia/tegra210/vic04_ucode.bin",
        "nvidia/tegra210/xusb.bin",
    ],
    vendor: true,
    required: [
        "linux_firmware_nvidia-gm20b",
    ],
}
