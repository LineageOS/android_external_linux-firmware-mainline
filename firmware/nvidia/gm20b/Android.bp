install_symlink {
    name: "linux_firmware_nvidia_gm20b-symlink-1",
    visibility: ["//visibility:private"],
    symlink_target: "../../gm200/gr/sw_method_init.bin",
    installed_location: "firmware/nvidia/gm20b/gr/sw_method_init.bin",
    vendor: true,
}

prebuilt_firmware {
    name: "linux_firmware_nvidia-gm20b",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    licenses: ["linux_firmware_nvidia_license"],
    srcs: [
        "acr/bl.bin",
        "acr/ucode_load.bin",
        "gr/fecs_bl.bin",
        "gr/fecs_data.bin",
        "gr/fecs_inst.bin",
        "gr/fecs_sig.bin",
        "gr/gpccs_data.bin",
        "gr/gpccs_inst.bin",
        "gr/sw_bundle_init.bin",
        "gr/sw_ctx.bin",
        "gr/sw_nonctx.bin",
        "pmu/desc.bin",
        "pmu/image.bin",
        "pmu/sig.bin",
    ],
    dsts: [
        "nvidia/gm20b/acr/bl.bin",
        "nvidia/gm20b/acr/ucode_load.bin",
        "nvidia/gm20b/gr/fecs_bl.bin",
        "nvidia/gm20b/gr/fecs_data.bin",
        "nvidia/gm20b/gr/fecs_inst.bin",
        "nvidia/gm20b/gr/fecs_sig.bin",
        "nvidia/gm20b/gr/gpccs_data.bin",
        "nvidia/gm20b/gr/gpccs_inst.bin",
        "nvidia/gm20b/gr/sw_bundle_init.bin",
        "nvidia/gm20b/gr/sw_ctx.bin",
        "nvidia/gm20b/gr/sw_nonctx.bin",
        "nvidia/gm20b/pmu/desc.bin",
        "nvidia/gm20b/pmu/image.bin",
        "nvidia/gm20b/pmu/sig.bin",
    ],
    vendor: true,
    required: [
        "linux_firmware_nvidia-gm200-sw_method_init",
        "linux_firmware_nvidia_gm20b-symlink-1",
    ],
}
