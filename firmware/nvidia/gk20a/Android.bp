prebuilt_firmware {
    name: "linux_firmware_nvidia-gk20a",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    licenses: ["linux_firmware_nvidia_license"],
    srcs: [
        "fecs_data.bin",
        "fecs_inst.bin",
        "gpccs_data.bin",
        "gpccs_inst.bin",
        "sw_bundle_init.bin",
        "sw_ctx.bin",
        "sw_method_init.bin",
        "sw_nonctx.bin",
    ],
    dsts: [
        "nvidia/gk20a/fecs_data.bin",
        "nvidia/gk20a/fecs_inst.bin",
        "nvidia/gk20a/gpccs_data.bin",
        "nvidia/gk20a/gpccs_inst.bin",
        "nvidia/gk20a/sw_bundle_init.bin",
        "nvidia/gk20a/sw_ctx.bin",
        "nvidia/gk20a/sw_method_init.bin",
        "nvidia/gk20a/sw_nonctx.bin",
    ],
    vendor: true,
    required: [],
}
