prebuilt_firmware {
    name: "firmware_qca_crbtfw21.tlv",
    src: "crbtfw21.tlv",
    filename_from_src: true,
    soc_specific: true,
    sub_dir: "qca",
}

prebuilt_firmware {
    name: "firmware_qca_crnv21.bin",
    src: "crnv21.bin",
    filename_from_src: true,
    soc_specific: true,
    sub_dir: "qca",
}

prebuilt_firmware {
    name: "linux_firmware_qca-wcn785x",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    srcs: [
        "hmtbtfw20.tlv",
        "hmtnv20.b10f",
        "hmtnv20.b112",
        "hmtnv20.bin",
    ],
    dsts: [
        "hmtbtfw20.tlv",
        "hmtnv20.b10f",
        "hmtnv20.b112",
        "hmtnv20.bin",
    ],
    relative_install_path: "qca",
    vendor: true,
    required: [],
}
