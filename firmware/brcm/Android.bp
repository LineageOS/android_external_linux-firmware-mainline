license {
    name: "linux_firmware_brcm_license",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    license_kinds: ["BSD-Binary-Only"],
    license_text: ["LICENSE"],
}

prebuilt_firmware {
    name: "linux_firmware_brcm-bcm43241",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    licenses: ["linux_firmware_brcm_license"],
    srcs: [
        "brcmfmac43241b0-sdio.bin",
        "brcmfmac43241b4-sdio.bin",
        "brcmfmac43241b5-sdio.bin",
    ],
    dsts: [
        "brcm/brcmfmac43241b0-sdio.bin",
        "brcm/brcmfmac43241b4-sdio.bin",
        "brcm/brcmfmac43241b5-sdio.bin",
    ],
    vendor: true,
    required: [],
}

prebuilt_firmware {
    name: "linux_firmware_brcm-bcm4354-nvidia_nvram",
    visibility: ["//external/linux-firmware-mainline:__subpackages__"],
    licenses: ["linux_firmware_brcm_license"],
    srcs: [
        "brcmfmac4354-sdio.nvidia,p2371-2180.txt",
    ],
    dsts: [
